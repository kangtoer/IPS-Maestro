rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Journal Rules ---
    match /journals/{journalId} {
      function isValidJournal(data) {
        return data.keys().hasAll(['id', 'date', 'activity', 'class', 'topic', 'notes', 'teacher', 'timestamp', 'userId']) &&
               data.keys().size() == 9 &&
               data.id is string && data.id.size() <= 128 &&
               data.date is string && data.date.size() <= 32 &&
               data.activity is string && data.activity.size() <= 10000 &&
               data.class is string && data.class.size() <= 128 &&
               data.topic is string && data.topic.size() <= 1000 &&
               data.notes is string && data.notes.size() <= 20000 &&
               data.teacher is string && data.teacher.size() <= 256 &&
               data.timestamp is number &&
               data.userId == request.auth.uid;
      }

      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(incoming().userId) && isValidJournal(incoming()) && isValidId(journalId);
      allow update: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidJournal(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // --- Student Score Rules ---
    match /studentScores/{scoreId} {
      function isValidScore(data) {
        return data.keys().hasAll(['id', 'name', 'score', 'timestamp', 'userId']) &&
               data.keys().size() == 5 &&
               data.id is string && data.id.size() <= 128 &&
               data.name is string && data.name.size() <= 256 &&
               data.score is number &&
               data.timestamp is number &&
               data.userId == request.auth.uid;
      }

      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(incoming().userId) && isValidScore(incoming()) && isValidId(scoreId);
      allow update: if isOwner(existing().userId) && isOwner(incoming().userId) && isValidScore(incoming());
      allow delete: if isOwner(existing().userId);
    }
  }
}

