{
  "entities": {
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "A single entry in the teacher's journal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "activity": { "type": "string" },
        "class": { "type": "string" },
        "topic": { "type": "string" },
        "notes": { "type": "string" },
        "teacher": { "type": "string" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "date", "activity", "class", "topic", "notes", "teacher", "timestamp", "userId"]
    },
    "StudentScore": {
      "title": "Student Score",
      "description": "A single student's score",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number" },
        "userId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "name", "score", "userId", "timestamp"]
    }
  },
  "firestore": {
    "/journals/{journalId}": {
      "schema": "JournalEntry",
      "description": "Teacher journal entries collection"
    },
    "/studentScores/{scoreId}": {
      "schema": "StudentScore",
      "description": "Student scores collection"
    }
  }
}
